{
  "name": "pi-web-tools",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test '*.test.ts' 'core/*.test.ts' 'shared/*.test.ts' 'fetch/*.test.ts' 'providers/*/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "typebox": "*"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.85.0",
    "@earendil-works/pi-server": "0.85.0",
    "@types/node": "26.4.1",
    "typescript": "6.0.3"
  }
}
