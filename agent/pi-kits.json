{
  "$schema": "https://raw.githubusercontent.com/aqua2k1/pi-kits/main/pi-kits.schema.json",
  "pi-web-kits": {
    "enabled": true,
    "search": {
      "enabled": true,
      "sources": {
        "web": {
          "enabled": true,
          "routing": ["codex-alpha-search" ],
           "codex": {
              "model": "gpt-6-luna"
           }
        },
        "github": {
          "enabled": true
        }
      },
      "timeoutMs": 15000,
      "maxResults": 10
    },
    "fetch": {
      "enabled": true,
      "timeoutMs": 15000,
      "github": {
        "enabled": true
      }
    }
  },
  "pi-subagent": {
    "enabled": true,
    "maxConcurrent": 4,
    "extensionAllowlist": [
      "builtin:codemode",
      "builtin:tool-search",
      "builtin:mcp",
      {
        "source": "https://github.com/aqua2k1/pi-kits.git",
        "extensions": [
          "pi-web-kits",
          "pi-ask"
        ]
      }
    ]
  }
}
