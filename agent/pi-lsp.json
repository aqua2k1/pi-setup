{
  "timeout": 20000,
  "servers": {
    "biome": {
      "command": ["biome", "lsp-proxy"],
      "extensions": [
        ".astro",
        ".css",
        ".cts",
        ".cjs",
        ".graphql",
        ".gql",
        ".html",
        ".js",
        ".json",
        ".jsonc",
        ".jsx",
        ".mjs",
        ".mts",
        ".svelte",
        ".ts",
        ".tsx",
        ".vue"
      ]
    },
    "ruff": {
      "command": ["ruff", "server"],
      "extensions": [".py", ".pyi"]
    },
    "rust-analyzer": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"],
      "pullDiagnosticsGraceMs": 5000
    },
    "gopls": {
      "command": ["gopls"],
      "extensions": [".go"]
    },
    "rubocop": {
      "command": ["rubocop", "--lsp"],
      "extensions": [".rb", ".rake", ".gemspec", ".ru"]
    },
    "elixir-ls": {
      "command": ["language_server.sh"],
      "extensions": [".ex", ".exs"],
      "skipDirectories": ["_build", "deps"]
    },
    "zls": {
      "command": ["zls"],
      "extensions": [".zig", ".zon"],
      "skipDirectories": [".zig-cache", "zig-out"]
    },
    "csharp": {
      "command": ["roslyn-language-server", "--stdio", "--autoLoadProjects"],
      "extensions": [".cs", ".csx"],
      "skipDirectories": ["bin", "obj"]
    },
    "fsharp": {
      "command": ["fsautocomplete"],
      "extensions": [".fs", ".fsi", ".fsx", ".fsscript"],
      "skipDirectories": ["bin", "obj"],
      "initialization": {
        "AutomaticWorkspaceInit": true
      }
    },
    "sourcekit-lsp": {
      "command": ["sourcekit-lsp"],
      "extensions": [".swift", ".mm"],
      "skipDirectories": [".build", "DerivedData"]
    },
    "clangd": {
      "command": ["clangd", "--background-index", "--clang-tidy"],
      "extensions": [
        ".c",
        ".cpp",
        ".cc",
        ".cxx",
        ".c++",
        ".h",
        ".hpp",
        ".hh",
        ".hxx",
        ".h++"
      ],
      "skipDirectories": ["build"]
    },
    "jdtls": {
      "command": ["jdtls"],
      "extensions": [".java"],
      "skipDirectories": [".gradle", "build"]
    },
    "kotlin-lsp": {
      "command": ["kotlin-lsp", "--stdio"],
      "extensions": [".kt", ".kts"],
      "skipDirectories": [".gradle", "build"]
    },
    "yaml-language-server": {
      "command": ["yaml-language-server", "--stdio"],
      "extensions": [".yaml", ".yml"]
    },
    "lua-language-server": {
      "command": ["lua-language-server"],
      "extensions": [".lua"],
      "pushDiagnosticsGraceMs": 3000
    },
    "intelephense": {
      "command": ["intelephense", "--stdio"],
      "extensions": [".php"],
      "initialization": {
        "intelephense": {
          "telemetry": {
            "enabled": false
          }
        }
      },
      "diagnosticsSettleMs": 4000
    },
    "prisma": {
      "command": ["prisma-language-server", "--stdio"],
      "extensions": [".prisma"]
    },
    "dart": {
      "command": ["dart", "language-server"],
      "extensions": [".dart"],
      "skipDirectories": [".dart_tool", "build"],
      "pushDiagnosticsGraceMs": 2000
    },
    "ocaml-lsp": {
      "command": ["ocamllsp"],
      "extensions": [".ml", ".mli"],
      "skipDirectories": ["_build", "_opam"]
    },
    "bash-language-server": {
      "command": ["bash-language-server", "start"],
      "extensions": [".sh", ".bash"]
    },
    "terraform-ls": {
      "command": ["terraform-ls", "serve"],
      "extensions": [".tf", ".tfvars"],
      "skipDirectories": [".terraform"],
      "pushDiagnosticsGraceMs": 2000,
      "initialization": {
        "experimentalFeatures": {
          "prefillRequiredFields": true
        }
      }
    },
    "texlab": {
      "command": ["texlab"],
      "extensions": [".tex", ".bib"]
    },
    "gleam": {
      "command": ["gleam", "lsp"],
      "extensions": [".gleam"],
      "skipDirectories": ["build"],
      "pushDiagnosticsGraceMs": 2000
    },
    "clojure-lsp": {
      "command": ["clojure-lsp", "listen"],
      "extensions": [".clj", ".cljs", ".cljc", ".edn"],
      "skipDirectories": [".cpcache"]
    },
    "nixd": {
      "command": ["nixd"],
      "extensions": [".nix"]
    },
    "tinymist": {
      "command": ["tinymist"],
      "extensions": [".typ", ".typc"],
      "pushDiagnosticsGraceMs": 2000
    },
    "haskell-language-server": {
      "command": ["haskell-language-server-wrapper", "--lsp"],
      "extensions": [".hs", ".lhs"],
      "skipDirectories": [".stack-work", "dist-newstyle"],
      "pushDiagnosticsGraceMs": 3000
    }
  }
}
